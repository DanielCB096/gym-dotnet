<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GymService</RootNamespace>
    <AssemblyName>GymService</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Ruta de las ANXO Libraries (pilot). Prioridad: -p:AnxoRoot, ANXO_ROOT, ruta por defecto. -->
    <AnxoRoot Condition="'$(AnxoRoot)' == '' and '$(ANXO_ROOT)' != ''">$(ANXO_ROOT)</AnxoRoot>
    <AnxoRoot Condition="'$(AnxoRoot)' == ''">..\..\..\repositorios\pilot\ANXO LIBRARIES</AnxoRoot>
  </PropertyGroup>

  <Target Name="ValidateAnxoRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(AnxoRoot)')"
           Text="No se encontró ANXO Libraries en '$(AnxoRoot)'. Copia la carpeta o define ANXO_ROOT / -p:AnxoRoot=&quot;ruta&quot;." />
  </Target>

  <ItemGroup Condition="Exists('$(AnxoRoot)')">
    <!-- ANXO Libraries -->
    <ProjectReference Include="$(AnxoRoot)\AnxoServiceTools\AnxoServiceTools.csproj" />
    <ProjectReference Include="$(AnxoRoot)\AnxoDatabase\AnxoDatabase.csproj" />
    <ProjectReference Include="$(AnxoRoot)\AnxoObjectDatabaseManager\AnxoObjectDatabaseManager.csproj" />
    <ProjectReference Include="$(AnxoRoot)\AnxoLibrary\AnxoLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core for Kestrel web server -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Additional NuGet packages -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- No se publica: contiene credenciales locales. El instalador crea el suyo. -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- El NLS de Anxo se carga como recurso embebido (NlsTools.LoadAssemblyMessages). -->
    <EmbeddedResource Include="nls.xml" />
  </ItemGroup>

</Project>

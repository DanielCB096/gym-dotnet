<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GymService</RootNamespace>
    <AssemblyName>GymService</AssemblyName>
    <Version>1.7.6</Version>
    <!-- Ruta de las GymCore Libraries. Prioridad: -p:GymLibsRoot, GYM_LIBS_ROOT, copia local. -->
    <GymLibsRoot Condition="'$(GymLibsRoot)' == '' and '$(GYM_LIBS_ROOT)' != ''">$(GYM_LIBS_ROOT)</GymLibsRoot>
    <GymLibsRoot Condition="'$(GymLibsRoot)' == ''">..\third_party\gym-core</GymLibsRoot>
  </PropertyGroup>

  <Target Name="ValidateGymLibsRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GymLibsRoot)')"
           Text="No se encontraron las GymCore Libraries en '$(GymLibsRoot)'. Copia la carpeta o define GYM_LIBS_ROOT / -p:GymLibsRoot=&quot;ruta&quot;." />
  </Target>

  <ItemGroup Condition="Exists('$(GymLibsRoot)')">
    <!-- GymCore Libraries (ensamblados Anxo*; el rebranding completo es la fase C). -->
    <ProjectReference Include="$(GymLibsRoot)\AnxoServiceTools\AnxoServiceTools.csproj" />
    <ProjectReference Include="$(GymLibsRoot)\AnxoDatabase\AnxoDatabase.csproj" />
    <ProjectReference Include="$(GymLibsRoot)\AnxoObjectDatabaseManager\AnxoObjectDatabaseManager.csproj" />
    <ProjectReference Include="$(GymLibsRoot)\AnxoLibrary\AnxoLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core for Kestrel web server -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Additional NuGet packages -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- No se publica: contiene credenciales locales. El instalador crea el suyo. -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- El NLS de GymCore se carga como recurso embebido (NlsTools.LoadAssemblyMessages). -->
    <EmbeddedResource Include="nls.xml" />
  </ItemGroup>

</Project>

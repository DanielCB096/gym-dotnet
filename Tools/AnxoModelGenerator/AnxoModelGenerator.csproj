<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Envoltorio SOLO para el proyecto del gimnasio.

    Las ANXO Libraries están en C:\repositorios\pilot y no se modifican: el generador
    original (AnxoDatabaseGenerator) declara net8.0 y no puede compilar contra las
    librerías net10.0, así que aquí compilamos sus mismos fuentes en un ejecutable net10.0.

    Uso (desde GymService\Models\Generated):
      dotnet run (project) <ruta a este csproj> [separador] ..\_ModelGym.xml
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>AnxoModelGenerator</AssemblyName>
    <RootNamespace>AnxoDatabaseGenerator</RootNamespace>
    <AnxoRoot Condition="'$(AnxoRoot)' == '' and '$(ANXO_ROOT)' != ''">$(ANXO_ROOT)</AnxoRoot>
    <AnxoRoot Condition="'$(AnxoRoot)' == ''">..\..\..\..\repositorios\pilot\ANXO LIBRARIES</AnxoRoot>
  </PropertyGroup>

  <Target Name="ValidateAnxoRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(AnxoRoot)')"
           Text="No se encontró ANXO Libraries en '$(AnxoRoot)'. Copia la carpeta o define ANXO_ROOT / -p:AnxoRoot=&quot;ruta&quot;." />
  </Target>

  <ItemGroup Condition="Exists('$(AnxoRoot)')">
    <Compile Include="$(AnxoRoot)\AnxoDatabaseGenerator\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(AnxoRoot)')">
    <ProjectReference Include="$(AnxoRoot)\AnxoLibrary\AnxoLibrary.csproj" />
    <ProjectReference Include="$(AnxoRoot)\AnxoDatabase\AnxoDatabase.csproj" />
    <ProjectReference Include="$(AnxoRoot)\AnxoObjectDatabaseManager\AnxoObjectDatabaseManager.csproj" />
  </ItemGroup>

</Project>

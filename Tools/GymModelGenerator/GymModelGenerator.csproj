<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Envoltorio SOLO para el proyecto del gimnasio.

    Las GymCore Libraries están en third_party\gym-core (o GYM_LIBS_ROOT) y no se modifican:
    el generador original (AnxoDatabaseGenerator) declara net8.0 y no puede compilar contra
    las librerías net10.0, así que aquí compilamos sus mismos fuentes en un ejecutable net10.0.

    Uso (desde GymService\Models\Generated):
      dotnet run (project) <ruta a este csproj> [separador] ..\_ModelGym.xml
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>GymModelGenerator</AssemblyName>
    <RootNamespace>GymCore.ModelGenerator</RootNamespace>
    <GymLibsRoot Condition="'$(GymLibsRoot)' == '' and '$(GYM_LIBS_ROOT)' != ''">$(GYM_LIBS_ROOT)</GymLibsRoot>
    <GymLibsRoot Condition="'$(GymLibsRoot)' == ''">..\..\third_party\gym-core</GymLibsRoot>
  </PropertyGroup>

  <Target Name="ValidateGymLibsRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GymLibsRoot)')"
           Text="No se encontraron las GymCore Libraries en '$(GymLibsRoot)'. Copia la carpeta o define GYM_LIBS_ROOT / -p:GymLibsRoot=&quot;ruta&quot;." />
  </Target>

  <ItemGroup Condition="Exists('$(GymLibsRoot)')">
    <Compile Include="$(GymLibsRoot)\AnxoDatabaseGenerator\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(GymLibsRoot)')">
    <ProjectReference Include="$(GymLibsRoot)\AnxoLibrary\AnxoLibrary.csproj" />
    <ProjectReference Include="$(GymLibsRoot)\AnxoDatabase\AnxoDatabase.csproj" />
    <ProjectReference Include="$(GymLibsRoot)\AnxoObjectDatabaseManager\AnxoObjectDatabaseManager.csproj" />
  </ItemGroup>

</Project>

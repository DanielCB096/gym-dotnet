<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Centro Fit Gym Manager"
           Manufacturer="Centro Fit"
           Version="$(var.ProductVersion)"
           UpgradeCode="6F2F2A2E-7B62-4E4E-9E1F-2B9E6B0C9A11"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Ya hay una version mas reciente de Centro Fit Gym Manager instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Property Id="OPEN_FIREWALL" Value="0" />
    <Property Id="WEB_PORT" Value="5000" />
    <Property Id="FIREWALL_REMOTE" Value="localsubnet" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CENTROFITFOLDER" Name="Centro Fit">
        <Directory Id="INSTALLFOLDER" Name="GymService" />
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Centro Fit Gym Manager" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\GymService.exe" />
        <Exclude Files="$(var.PublishDir)\install.ps1" />
        <Exclude Files="$(var.PublishDir)\uninstall.ps1" />
        <Exclude Files="$(var.PublishDir)\VERSION.txt" />
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
      </Files>

      <ComponentRef Id="GymServiceExe" />
      <ComponentRef Id="AppSettings" />
    </Feature>

    <!-- El ejecutable se autora a mano porque registra el servicio de Windows. -->
    <Component Id="GymServiceExe" Directory="INSTALLFOLDER" Guid="*">
      <File Id="GymServiceExe" Source="$(var.PublishDir)\GymService.exe" KeyPath="yes" />

      <ServiceInstall Id="InstallGymService"
                      Name="centrofitgymservice"
                      DisplayName="Centro Fit Gym Service"
                      Description="API y panel de Centro Fit"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="NT SERVICE\centrofitgymservice" />

      <ServiceControl Id="ControlGymService"
                      Name="centrofitgymservice"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!-- Configuracion inicial: no se sobrescribe en actualizaciones y se conserva al desinstalar. -->
    <Component Id="AppSettings" Directory="INSTALLFOLDER" Guid="*" NeverOverwrite="yes" Permanent="yes">
      <File Id="AppSettingsJson"
            Source="$(var.PublishDir)\appsettings.example.json"
            Name="appsettings.json"
            KeyPath="yes" />
    </Component>

    <CustomAction Id="GrantServiceAcls"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Set-ServiceAccount.ps1&quot; -ConfigPath &quot;[INSTALLFOLDER]appsettings.json&quot; -SkipRestart" />

    <CustomAction Id="ServiceDependsSql"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="sc.exe config centrofitgymservice depend= MSSQLSERVER" />

    <CustomAction Id="ServiceDelayedStart"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="sc.exe config centrofitgymservice start= delayed-auto" />

    <CustomAction Id="ServiceRecovery"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="sc.exe failure centrofitgymservice reset= 86400 actions= restart/60000/restart/120000/restart/180000" />

    <CustomAction Id="OpenFirewall"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="netsh.exe advfirewall firewall add rule name=&quot;GymService HTTPS&quot; dir=in action=allow protocol=TCP localport=[WEB_PORT] remoteip=[FIREWALL_REMOTE] profile=any" />

    <CustomAction Id="RemoveFirewall"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="netsh.exe advfirewall firewall delete rule name=&quot;GymService HTTPS&quot;" />

    <CustomAction Id="RemoveFirewallLegacy"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  ExeCommand="netsh.exe advfirewall firewall delete rule name=&quot;GymService HTTP&quot;" />

    <InstallExecuteSequence>
      <Custom Action="GrantServiceAcls" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="ServiceDependsSql" After="GrantServiceAcls" Condition="NOT Installed" />
      <Custom Action="ServiceDelayedStart" After="ServiceDependsSql" Condition="NOT Installed" />
      <Custom Action="ServiceRecovery" After="ServiceDelayedStart" Condition="NOT Installed" />
      <Custom Action="OpenFirewall" After="ServiceRecovery" Condition="OPEN_FIREWALL=1 AND NOT Installed" />
      <Custom Action="RemoveFirewall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RemoveFirewallLegacy" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
